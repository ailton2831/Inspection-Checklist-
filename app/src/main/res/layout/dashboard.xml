<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".DashBoard.DashboardActivity">


    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="DashBoard"
            android:textSize="25dp"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:textStyle="bold">
        </TextView>


        <LinearLayout
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_margin="5dp"
                android:layout_width="120dp"
                android:layout_height="165dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card1"
                android:padding="10dp">

                <TextView
                    android:id="@+id/totalinspeçoes"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:textSize="40sp"
                    android:gravity="center"
                    android:text=""/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total\nInspecções"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_gravity="center"/>

            </LinearLayout>

            <LinearLayout
                android:layout_margin="5dp"
                android:layout_width="120dp"
                android:layout_height="165dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card4"
                android:padding="10dp">

                <TextView
                    android:id="@+id/totalaprovado"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:text=""/>

                <TextView
                    android:layout_marginTop="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aprovados"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_margin="5dp"
                android:layout_width="120dp"
                android:layout_height="165dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card3"
                android:padding="10dp">

                <TextView
                    android:id="@+id/totalreprovado"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:text=""/>


                <TextView
                    android:layout_marginTop="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reprovados"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_gravity="center"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_margin="2dp"
                android:layout_width="80dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card5"
                android:padding="10dp">

                <TextView
                    android:id="@+id/total2026"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:textSize="40sp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:text=""/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inspecções \n2026"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_gravity="center"/>

            </LinearLayout>

            <LinearLayout
                android:layout_margin="2dp"
                android:layout_width="80dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card5"
                android:padding="10dp">

                <TextView
                    android:id="@+id/totalperiodica"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:textSize="40sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:text=""/>

                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Periodicas"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_margin="2dp"
                android:layout_width="80dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card5"
                android:padding="10dp">

                <TextView
                    android:id="@+id/totalreinspeçao"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:textSize="40sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:text=""/>


                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reinspecções"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_gravity="center"/>
            </LinearLayout>

        </LinearLayout>


        <LinearLayout
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_margin="5dp"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card6"
                android:padding="10dp">

                <TextView
                    android:id="@+id/totalveiculo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:textSize="40sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:text=""/>

                <TextView
                    android:layout_marginTop="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total veículos registrados"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_gravity="center"/>

            </LinearLayout>



        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total veiculos - tipo"
            android:textSize="25dp"
            android:textStyle="bold"
            android:padding="10dp"/>

        <LinearLayout
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_margin="5dp"
                android:layout_width="100dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card7"
                android:padding="10dp">

                <TextView
                    android:id="@+id/totalligeirop"
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:textSize="40sp"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:text=""/>

                <TextView
                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ligeiro\nParticular"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_margin="5dp"
                android:layout_width="100dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card7"
                android:padding="10dp">

                <TextView
                    android:id="@+id/totalligeirotp"
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:textSize="40sp"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:text=""/>


                <TextView
                    android:layout_marginTop="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ligeiro\nTransporte\npúblico"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_margin="5dp"
                android:layout_width="100dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card7"
                android:padding="10dp">

                <TextView
                    android:id="@+id/totalpesado"
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:textSize="40sp"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:text=""/>


                <TextView
                    android:layout_marginTop="35dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pesado"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_gravity="center"/>
            </LinearLayout>

        </LinearLayout>


    </LinearLayout>






</ScrollView>